# Auto Drive rclone configuration
#
# Auto Drive stores file content permanently on the Autonomys Network.
# Get your API key at https://ai3.storage (Developers section).
#
# Usage:
#   rclone copy ./files/ autodrive:my-bucket/my-archive/
#
# The first segment of the destination path is the bucket name.
# Buckets are created on first write and are private to your account.
# Organize files using key prefixes (the path after the bucket name).

[autodrive]
type = s3
provider = Other
access_key_id = YOUR_API_KEY_HERE
# Required by rclone but not checked by Auto Drive: the API key is the credential.
secret_access_key = placeholder
endpoint = https://s3.auto-drive.autonomys.xyz
# Required: Auto Drive has no bucket-level endpoints (CreateBucket, HeadBucket).
no_check_bucket = true
# Required: Auto Drive implements the ListObjectsV2 API only. Without this,
# rclone defaults to the V1 listing API and directory listings fail.
list_version = 2
# Recommended: URL-encode listings so keys with special characters list correctly.
list_url_encode = true

# For local development, use:
# endpoint = http://localhost:3000/s3
