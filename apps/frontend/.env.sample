GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=
DISCORD_AUTH_CLIENT_ID=
DISCORD_AUTH_CLIENT_SECRET=
NEXT_PUBLIC_MAX_FILES_LIMIT=10
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_RPC_ENDPOINT="https://auto-evm-0.taurus.subspace.network/ws"

# Ethereum RPC endpoints for the USDC purchase flow.
#
# Optional. Left unset, viem's built-in defaults for these chains apply — shared
# public RPCs, which this flow reads through before it can do anything useful (the
# buyer's USDC balance, and the allowance held by the receiver). A rate-limited
# read there surfaces as a failed purchase for a wallet that was perfectly funded,
# so set these in any deployment that actually sells USDC.
#
# Which chain is live is decided by the BACKEND (ETH_CHAIN_ID, served via
# GET /payments/usdc/target), not here. These are only the endpoints used to talk
# to a chain once the backend has named it.
NEXT_PUBLIC_ETH_RPC_URL=
NEXT_PUBLIC_ETH_SEPOLIA_RPC_URL=

# Register Sepolia with the user's wallet alongside Ethereum. Off unless set to
# "true", and inlined at build time like the two above.
#
# Every chain this build lists is offered to EVERY user of the deployment, so a
# production build should not advertise a testnet. Set it for #752's Sepolia run;
# leave it unset on mainnet, where a target naming any other chain then reads as
# "this app cannot pay USDC here" rather than silently switching a wallet to a
# testnet.
NEXT_PUBLIC_USDC_TESTNET_CHAINS=
