DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
OBJECT_MAPPING_ARCHIVER_URL=wss://indexer.mainnet.autonomys.xyz/ws # update to your own; /ws path is required for HTTP RPC transport
FILES_GATEWAY_URL=http://changeme.com # change to your own (or it'll fail when fetching archived files)
FILES_GATEWAY_TOKEN=changeme # change to your own (or it'll fail when fetching archived files)
AUTH_SERVICE_API_KEY=1234567890 # change to your own if updated in auth
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ---------------------------------------------------------------------------
# On-chain publishing (consensus chain)
# ---------------------------------------------------------------------------

# Reorg safety margin for publishing. A transaction is only recorded as
# published once this many blocks have been built on top of its inclusion
# block AND that block is still canonical. Prevents "phantom" published nodes
# from chain reorgs (see issue #706). Default 25 (~2.5 min at 6s/block).
CHAIN_CONFIRMATION_DEPTH=25

# Max time a single transaction may wait to reach CHAIN_CONFIRMATION_DEPTH
# before timing out. Must exceed CHAIN_CONFIRMATION_DEPTH * block time with
# margin. Default 300000ms (5 min).
CHAIN_TRANSACTION_TIMEOUT_MS=300000

# Safety-net cadence (ms) for confirming published transactions. Confirmation is
# normally driven by a new-heads subscription; if that subscription goes silent
# after a WebSocket reconnect, the chain head is also polled on this interval so
# confirmation still completes instead of stranding the tx in "publishing".
# Default 6000ms (~1 block at 6s/block).
CHAIN_CONFIRMATION_POLL_INTERVAL_MS=6000

# Backstop timeout for a single publish-manager task (publish-nodes /
# ensure-object-published). Guards against a transaction that is perpetually
# re-included never settling and pinning a publish-worker slot forever: on
# timeout the task is aborted and retried instead of deadlocking. Keep it well
# above the legitimate batch confirmation time (a 50-node batch drained through
# CHAIN_TRANSACTION_TIMEOUT_MS-bounded confirmations). Default 3600000ms (60 min).
PUBLISH_TASK_TIMEOUT_MS=3600000

# ---------------------------------------------------------------------------
# Pay-with-AI3 / purchased credits feature
# ---------------------------------------------------------------------------

# Feature flags — set BUY_CREDITS_ACTIVE=true to enable the purchase flow.
# BUY_CREDITS_STAFF_ONLY=true restricts it to admin/staff accounts only,
# useful for a staged rollout before opening to all users.
BUY_CREDITS_ACTIVE=false
BUY_CREDITS_STAFF_ONLY=false

# EVM endpoint for the AutoDriveCreditsReceiver contract.
# Point this at the Auto-EVM RPC for the target network (mainnet or Taurus
# testnet).  The payment manager watches this chain for deposit events.
EVM_CHAIN_ENDPOINT=http://localhost:8545

# Address of the deployed AutoDriveCreditsReceiver contract.
# Must match the chain pointed to by EVM_CHAIN_ENDPOINT.
EVM_CHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# EVM chain ID for the network where the contract is deployed.
# Mainnet Auto-EVM = 870, Chronos Testnet = 8700.
EVM_CHAIN_ID=870

# Number of block confirmations to wait before treating a payment as final.
# Higher values reduce the risk of processing a payment that is later
# reversed by a chain reorganisation. Default: 6.
EVM_CHAIN_CONFIRMATIONS=6

# How often (in milliseconds) the payment manager polls for CONFIRMED intents
# that have not yet had credits applied. This is a fallback for cases where
# the event watcher misses a log. Default: 30000 (30 seconds).
EVM_CHAIN_CHECK_INTERVAL=30000

# Price multiplier applied on top of the raw Autonomys consensus fee to
# determine the AI3 cost per byte. A value of 5.0 means users pay 5× the
# current on-chain transaction byte fee. Default: 5.00.
CREDITS_PRICE_MULTIPLIER=5.00

# ---------------------------------------------------------------------------
# Credit lifecycle
# ---------------------------------------------------------------------------

# Number of days after purchase before a credit batch expires.
# Users see this value on the purchase confirmation screen and in their credit
# history. Default: 90.
CREDIT_EXPIRY_DAYS=90

# Maximum total purchased upload bytes allowed per user across all active
# (non-expired) credit rows. Attempts to purchase beyond this cap result in
# an OVER_CAP intent requiring admin review. Default: 107374182400 (100 GiB).
MAX_CREDITS_PER_USER=107374182400

# How often (in milliseconds) the background job runs to mark expired credit
# rows and clean up stale PENDING intents. Default: 3600000 (1 hour).
CREDIT_EXPIRY_CHECK_INTERVAL=3600000

# How many minutes a PENDING intent remains valid before it is treated as
# expired. Users must submit their on-chain transaction within this window
# after creating an intent. Default: 10.
INTENT_EXPIRY_MINUTES=10

# How many minutes past its expiry a PENDING intent that already carries a
# transaction hash is still left alone. A hash normally means "being watched, will
# resolve", so such rows are exempt from expiry — but a payment the watcher
# refused, or a transaction that never confirms, would otherwise keep the row
# payable forever and re-watched on every restart. Inside this window nothing
# changes and slow confirmations settle as usual. Default: 1440 (24 hours).
INTENT_TX_GRACE_MINUTES=1440

# ---------------------------------------------------------------------------
# USDC payments — AI3/USD price oracle (WAI3/USDC swap history) & quote margin
# ---------------------------------------------------------------------------

# Ethereum mainnet RPC endpoint. Distinct from EVM_CHAIN_ENDPOINT, which points
# at Auto EVM — two different chains, so keep the endpoints separate.
#
# No longer read by the price oracle (which now sources its rate from an indexer,
# below) and no longer needs to be archive-capable. It is what the USDC payment
# manager watches the receiver contract on, and what the treasury balance check
# reads USDC balances through. Leave unset in a deployment that does not accept
# USDC.
ETH_CHAIN_ENDPOINT=

# ETH_USDC_RECEIVER_ADDRESS below is the switch for accepting USDC. Set it and
# ETH_CHAIN_ENDPOINT and USDC_TOKEN_ADDRESS become required — a partial
# configuration refuses to start, because the alternative is a watcher that
# cannot see the receiver, and "no USDC payments are arriving" looks exactly like
# a quiet day. Leave the receiver unset to run AI3 payments only; an endpoint on
# its own is fine, since the treasury balance check reads through it too.

# AutoDriveUSDCReceiver: the contract USDC payments are made to, and the address
# payment events are watched on. 1 (mainnet) or 11155111 (Sepolia) for testing.
ETH_USDC_RECEIVER_ADDRESS=

# The ERC20 the receiver above was deployed against. Every payment event names
# the token it moved, and one that is not this address is refused rather than
# credited: the whole quote is denominated in dollars and every conversion
# assumes 6 decimals, so a token with 18 would read as a payment 10^12 times the
# one that arrived. Ethereum mainnet USDC is
# 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48.
USDC_TOKEN_ADDRESS=

# Chain id of the endpoint above. Served to the frontend so a wallet can be
# asked to switch networks. 1 = Ethereum mainnet, 11155111 = Sepolia.
ETH_CHAIN_ID=1

# Blocks that must build on a USDC payment before it is credited. Ethereum is
# post-Merge, so 2-3 is already economically final; 6 is conservative and
# matches EVM_CHAIN_CONFIRMATIONS, which keeps one fewer number in your head.
ETH_CHAIN_CONFIRMATIONS=6

# The oracle averages the pool's most recent REALIZED swaps, read from its
# published subgraph through The Graph's gateway. Realized fills rather than pool
# state, because USDC is now converted to AI3 manually and in batches rather than
# swapped per intent: what a purchase should be priced against is what the pool
# has actually been filling at, fee and price impact already inside the number.
#
# Gateway query URL for the subgraph. Required only when quoting in USDC — leave
# unset otherwise and the oracle is never invoked.
GRAPH_SUBGRAPH_URL=

# API key the gateway is queried with. SECRET — never commit a real value, and
# note it is billed per query, which is one more reason the derived rate is
# cached (ORACLE_CACHE_TTL_MS) rather than read per request.
GRAPH_API_KEY=

# How long (ms) a freshly derived rate is served from memory before the next
# refresh. Safe to cache, unlike the spot price this replaced: a minute cannot
# move an average built from days of fills. Default: 60000 (1 min).
ORACLE_CACHE_TTL_MS=60000

# Longest (ms) the last-good price may be served as a fallback while the window
# cannot be read. Default: 600000 (10 min).
ORACLE_MAX_STALE_MS=600000

# Budget (ms) for the whole subgraph query, including connect and body read.
# Default: 10000.
ORACLE_REQUEST_TIMEOUT_MS=10000

# Cap on how many fills one query may return, and the fewest that may stand
# behind a rate. The floor is checked twice: on the window as fetched, and again
# after the outlier trim below, so a window trimmed down to two swaps is refused
# rather than averaged.
#
# The cap is NOT the window — ORACLE_MAX_WINDOW_AGE_MS below is, and it is applied
# in the query itself. A window selected by count and then filtered by age is a
# count window whatever the age says, because filtering can only shrink the count
# and never reach past it for an older fill: a burst of trades would evict the
# market's history instead of competing with it, at a cost that does not depend on
# how much the market traded.
#
# So the cap wants to sit far above any real week. The busiest 7 days in this
# pool's entire recorded history is 53 fills. A FULL page means the window may
# have been cut short and the oracle refuses with `window-truncated` rather than
# averaging a slice, so this is a knob to raise, never to lower.
ORACLE_MAX_WINDOW_SAMPLES=1000
ORACLE_MIN_SWAP_SAMPLES=5

# Refuse to quote when the most recent swap is older than this (ms). A window can
# be perfectly well-formed and still describe a market that has since stopped.
# Default: 86400000 (24h).
ORACLE_MAX_SWAP_AGE_MS=86400000

# THE WINDOW: fills older than this (ms) are not fetched and cannot vote. It is
# applied in the query, which is what makes the window a period of time rather
# than a count of slots. Without a lower bound a majority of ancient fills
# carries the median, the trim then discards the RECENT fills as outliers, and the
# rate served comes from another era. A filter, not a refusal, so one stale fill
# cannot deny an otherwise live window.
# Default: 604800000 (7d), which at this pool's ~1.6 swaps/day normally holds
# comfortably more fills than the ORACLE_MIN_SWAP_SAMPLES floor.
ORACLE_MAX_WINDOW_AGE_MS=604800000

# Least time (ms) the surviving fills must span. The outlier trim measures
# against a count-based median, so whoever supplies most of the window sets the
# price, and clearing the volume floor with your own trades clears it at whatever
# price you like. Time is the part that cannot be faked: a burst of fills in one
# block is printable on demand, while the same fills spread across hours must be
# defended against everyone else trading in between — and that delay is what the
# treasury alerting needs to react.
# Default: 7200000 (2h).
ORACLE_MIN_WINDOW_SPAN_MS=7200000

# Refuse to quote when the INDEXER's own head is older than this (ms). Deliberately
# separate from the swap-age guard: an indexer that has stalled and a pool that has
# gone quiet are indistinguishable in the data and need different responses.
# Default: 900000 (15 min).
ORACLE_MAX_INDEX_LAG_MS=900000

# Least USDC (whole USDC) the pool must HOLD for its fills to be priced from,
# read from the pool's own USDC balance in the same query the swaps come from.
#
# Depth, as against the volume floor below: volume is what traded, and trading in
# a circle is cheap — a buy and a sell of the same size each contribute their full
# USDC leg, so an attacker clears a volume floor of N for roughly the swap fee on
# N (~1% here) while honest flow has to trade N for real. Depth cannot be churned
# into existence. It can be RAISED by buying, which hands the pool USDC and takes
# AI3 away, but that commits the whole amount as inventory at price risk plus a
# round trip's fees — an order of magnitude dearer, not a closed door.
#
# Default 1000, to be re-derived once this pool trades again: it held 2898 USDC on
# 2026-08-11, having been at zero five days earlier.
ORACLE_MIN_POOL_USDC_DEPTH=1000

# Least USDC volume (whole USDC) the surviving samples must total on their LARGER
# SIDE. Without this floor, ten dust swaps set the price of every purchase.
#
# One-sided rather than total, because a round trip contributes both of its legs
# to a total while committing capital once: buy $500 of AI3 and sell it straight
# back and a total records ~$1000 against $500 committed and no net position.
# One-directional flow scores its full volume either way, so the tightening falls
# on churn. Default: 1000.
ORACLE_MIN_WINDOW_VOLUME_USDC=1000

# Drop swaps whose realized price deviates further than this (percent) from the
# window's median before averaging. Volume weighting alone does not cover a
# manipulating trade that is simply large: there, its weight is exactly what makes
# it dangerous. Measured against the median rather than the mean, which the
# outliers themselves would move. Default: 25.
#
# This threshold also decides when the oracle stops quoting altogether. Because
# the median is count-based, a market that has genuinely re-priced puts the fills
# carrying the NEW price in the minority — so the trim discards exactly those and
# averages a majority that has not caught up. The oracle therefore refuses
# (reason: market-moved) whenever the newest fill in the window is itself trimmed:
# better to shut the payment path than to charge at a price the pool has left.
# Widening this makes that refusal rarer and the stale-price window wider; both
# directions have a cost, so derive it from how far this pool actually moves
# between consecutive fills.
#
# This and the floors above are functions of how much this pool trades and how
# deep it is, so RE-DERIVE them against live history before launch rather than
# inheriting these defaults.
ORACLE_MAX_SWAP_DEVIATION=25

# Sanity bounds for the AI3/USD price, as plain decimals (NOT exponential
# notation). A value outside [min, max] is treated as a glitch and dropped.
# Defaults: 0.0001 and 100.
ORACLE_MIN_USD_PER_AI3=0.0001
ORACLE_MAX_USD_PER_AI3=100

# Margin (percent) added on top of the raw oracle-derived USD cost when quoting
# a USDC payment. The stored AI3/USD rate remains the raw market rate; only the
# amount the user pays includes this margin. Default: 5.
USD_QUOTE_MARGIN=5

# Slack alerting for tasks that exhausted their retries and landed on an error
# queue (frontend-errors / download-errors / publish-errors). The channel is
# encoded in the incoming-webhook URL, so there is no separate channel setting.
# Leave unset to disable alerting. The error queues are then left unconsumed, so
# failed tasks accumulate on them (as they did before alerting existed) rather
# than being acked away into log lines that a rotation eventually takes with them.
SLACK_WEBHOOK_URL=
# Failures are batched into one message per window rather than posted one by one,
# so draining a backlog cannot flood the channel. The window trades alert latency
# for a quieter channel; these tasks have already exhausted every retry, so
# nothing is waiting on the notification. Defaults: 1800000 (30 min) and 10.
TASK_ERROR_ALERT_WINDOW_MS=1800000
TASK_ERROR_ALERT_MAX_ITEMS=10
